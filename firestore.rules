rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /artifacts/{appId} {
      
      // Reglas para los escaneos privados de cada usuario
      match /users/{userId}/scans/{scanId} {
        // Solo el propio usuario puede leer y escribir sus propios escaneos
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Reglas para el ranking global (leaderboard) y perfiles públicos
      match /public/data/leaderboard/{userId} {
        // Cualquier usuario autenticado puede ver el ranking de los demás
        allow read: if request.auth != null;
        // Los usuarios solo pueden escribir o actualizar sus propios datos en el ranking
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
